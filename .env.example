# GitHub personal access token with pull-request write access
# Create one at: github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Claude API key
# Create one at: console.anthropic.com
ANTHROPIC_API_KEY=your_claude_api_key_here

# Only needed when testing locally (GitHub Actions sets these automatically)
GITHUB_REPOSITORY=Tanishk-25/ai-code-review-bot
PR_NUMBER=1